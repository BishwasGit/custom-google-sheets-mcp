{
  "name": "google-sheets-mcp",
  "version": 2,
  "public": false,
  "buildCommand": "echo 'no-build'",
  "routes": [
    {
      "src": "/api/tools",
      "dest": "api/tools.js"
    },
    {
      "src": "/(.*)",
      "dest": "public/$1"
    },
    {
      "src": "/",
      "dest": "public/index.html"
    }
  ]
}
